{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "pep621",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**",
    "requirements-build.lock",
    "requirements.lock",
    "pyproject.toml"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "pip_requirements"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "These generated locks use compile flags unsupported by the pinned Renovate parser; regenerate them through the documented source workflow.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-build.lock",
        "requirements.lock"
      ],
      "enabled": false
    },
    {
      "description": "These source inputs must change together with their generated locks through the documented regeneration command; the pinned native manager cannot preserve those lock command flags.",
      "matchManagers": [
        "pip_requirements",
        "pep621"
      ],
      "matchFileNames": [
        "pyproject.toml"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": false
  }
}
