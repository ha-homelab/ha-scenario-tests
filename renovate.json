{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "dockerfile",
    "pep621",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**",
    "requirements.lock",
    "pyproject.toml"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621",
        "pip_requirements",
        "pip-compile"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "* * * * 1"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchFileNames": [
        "/^[^/]+$/"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Regenerate compiled locks with their recorded source command; avoid independent edits to inputs or output snapshots.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        ".github/requirements-wheels-only.in",
        "requirements-build.in",
        "requirements-build.lock"
      ],
      "enabled": false
    },
    {
      "description": "These generated locks use compile flags unsupported by the pinned Renovate parser; regenerate them through the documented source workflow.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements.lock"
      ],
      "enabled": false
    },
    {
      "description": "The build backend must match the manually regenerated root pyproject; independent build frontend updates remain native.",
      "matchManagers": [
        "pip-compile"
      ],
      "matchFileNames": [
        "requirements-build.in"
      ],
      "matchPackageNames": [
        "setuptools"
      ],
      "enabled": false
    },
    {
      "description": "These source inputs must change together with their generated locks through the documented regeneration command; the pinned native manager cannot preserve those lock command flags.",
      "matchManagers": [
        "pip_requirements",
        "pep621"
      ],
      "matchFileNames": [
        "pyproject.toml"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      ".github/cosign/**",
      "requirements.lock",
      "pyproject.toml",
      ".github/requirements-wheels-only.in",
      "requirements-build.in",
      "requirements-build.lock"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\-build\\.lock$/"
    ]
  }
}
